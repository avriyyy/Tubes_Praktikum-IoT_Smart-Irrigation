# Environment template for the Coolify application resource.
# Paste these as Environment Variables in Coolify (values marked <...> come
# from the Coolify PostgreSQL database page, "internal" connection section).
# Never commit real secrets to git.

APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<domain-aplikasi-di-coolify>

# Generate locally and paste the output:
#   php artisan key:generate --show
APP_KEY=<base64:...>

DB_CONNECTION=pgsql
DB_HOST=l3qbfxdexxvtokv4xajtsxtw
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
# Copy from the Coolify database page (postgres_password).
DB_PASSWORD=<password-postgres-dari-coolify>

# MQTT broker (public, same as local development).
MQTT_HOST=mqtt.apriyudha.my.id
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Client id MUST differ from any other running consumer (laptop, local).
MQTT_CLIENT_ID=dashboard-prod

LOG_CHANNEL=stack
LOG_LEVEL=info

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
